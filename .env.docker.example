# Docker Environment Configuration for Obviu.io
# Copy this file to .env and update the values for your deployment

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Session Security
SESSION_SECRET=your_very_long_random_session_secret_here

# Email Configuration (Required for password reset and user invitations)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Initial Admin User Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourdomain.com

# Application Configuration
VITE_DISABLE_REGISTRATION=false

# File Storage Configuration (automatically set in Docker)
UPLOAD_DIR=/app/uploads

# Video Processing Timeout Configuration (in milliseconds)
# Adjust these values based on your server performance and expected file sizes
# For 20GB+ files, consider increasing VIDEO_TIMEOUT_QUALITY to 7200000 (2 hours)
VIDEO_TIMEOUT_QUALITY=3600000      # Quality encoding timeout (default: 60 minutes)
VIDEO_TIMEOUT_SCRUB=1800000        # Scrub version timeout (default: 30 minutes)
VIDEO_TIMEOUT_SPRITE=600000        # Thumbnail sprite timeout (default: 10 minutes)
VIDEO_TIMEOUT_METADATA=300000      # Metadata extraction timeout (default: 5 minutes)

# Local Transcription (whisper.cpp) Configuration
# Transcription runs entirely on your server — no cloud / AI APIs required.
TRANSCRIPTION_ENABLED=true             # Set to false to disable auto-transcription
WHISPER_MODEL=base.en                  # Options: tiny.en, base.en, small.en, medium.en
WHISPER_THREADS=4                      # Number of CPU threads to use
# WHISPER_MODELS_DIR is set automatically to /app/models inside the container.
# Models (~141MB for base.en) are downloaded on first use into the whisper_models volume.

# Video Encoding Quality Settings (optional, defaults provided)
# VIDEO_MAIN_CRF=24                # Main quality CRF (lower = better quality, 18-28 recommended)
# VIDEO_MAIN_PRESET=medium         # Encoding speed preset (ultrafast, fast, medium, slow)
# VIDEO_SCRUB_CRF=28              # Scrub version CRF (can be higher since it's for timeline scrubbing)
# VIDEO_SCRUB_FPS=15              # Scrub version frame rate (lower = smaller files)
# VIDEO_SCRUB_SCALE=-2:180        # Scrub version resolution (height in pixels, -2 maintains aspect ratio)

# Security Note: 
# - Generate a strong SESSION_SECRET using: openssl rand -base64 32
# - Use a complex POSTGRES_PASSWORD
# - Obtain SENDGRID_API_KEY from https://sendgrid.com/
# - Change default admin credentials for production