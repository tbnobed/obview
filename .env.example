# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/obview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=obview

# Session Configuration
SESSION_SECRET=your_secure_session_secret_here

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Initial Admin User (used on first launch)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@yourdomain.com

# Registration Control
# Disable registration for new users (optional)
# Set to 'true' to disable the registration option on the auth page
# For Docker deployments: This environment variable must be set before building the Docker image
# Example: VITE_DISABLE_REGISTRATION=true docker-compose up --build
VITE_DISABLE_REGISTRATION=false

# Short-link domain for shareable links (optional)
# When set, share URLs returned by the API and rendered in the share dialog
# use this base instead of the current origin. Example: https://t.obviu.io
# Leaving it blank makes share URLs use whatever host the request came in on.
# Docker note: this value is BOTH a build-time arg (baked into the client
# bundle as VITE_SHORT_LINK_BASE_URL) AND a runtime env var on the server,
# both wired up via docker-compose.yml from the single SHORT_LINK_BASE_URL
# variable below. Rebuild with `docker compose build` after changing it.
SHORT_LINK_BASE_URL=

# Video Processing Timeout Configuration (in milliseconds)
# Adjust these values based on your server performance and expected file sizes
# For 20GB+ files, consider increasing VIDEO_TIMEOUT_QUALITY to 7200000 (2 hours)
VIDEO_TIMEOUT_QUALITY=3600000      # Quality encoding timeout (default: 60 minutes)
VIDEO_TIMEOUT_SCRUB=1800000        # Scrub version timeout (default: 30 minutes)
VIDEO_TIMEOUT_SPRITE=600000        # Thumbnail sprite timeout (default: 10 minutes)
VIDEO_TIMEOUT_METADATA=300000      # Metadata extraction timeout (default: 5 minutes)

# Video Encoding Quality Settings (optional, defaults provided)
# VIDEO_MAIN_CRF=24                # Main quality CRF (lower = better quality, 18-28 recommended)
# VIDEO_MAIN_PRESET=medium         # Encoding speed preset (ultrafast, fast, medium, slow)
# VIDEO_SCRUB_CRF=28              # Scrub version CRF (can be higher since it's for timeline scrubbing)
# VIDEO_SCRUB_FPS=15              # Scrub version frame rate (lower = smaller files)
# VIDEO_SCRUB_SCALE=-2:180        # Scrub version resolution (height in pixels, -2 maintains aspect ratio)